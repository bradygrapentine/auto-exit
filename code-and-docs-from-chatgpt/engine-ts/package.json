{
  "name": "kalshi-exit-assistant-engine",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts --config ./config.example.json",
    "server": "tsx src/server.ts --config ./config.example.json",
    "test": "vitest run",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "harness:read-only": "HARNESS=1 vitest run test/harness/read-only.harness.test.ts",
    "harness:update-baselines": "tsx scripts/harness-update-baselines.ts",
    "harness:mutation": "HARNESS=1 HARNESS_SUITE=mutation vitest run test/harness/mutation.harness.test.ts"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "^18.3.28",
    "@vitest/coverage-v8": "^1.6.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
